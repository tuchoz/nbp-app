# All values are non-secret; NBP is a public HTTPS API.
NBP_API_BASE_URL=https://api.nbp.pl/api/
NBP_ENFORCE_OFFICIAL_HOST=true
NBP_TIMEOUT_SECONDS=5
NBP_RETRY_ATTEMPTS=2
NBP_RETRY_BASE_DELAY_SECONDS=0.25
NBP_CACHE_PREPUBLICATION_SECONDS=3600
NBP_CACHE_PUBLICATION_SECONDS=300
NBP_CACHE_POSTPUBLICATION_SECONDS=3600
NBP_CACHE_MISSING_PUBLICATION_SECONDS=600
NBP_CACHE_NONBUSINESS_SECONDS=21600
NBP_MAX_STALE_SECONDS=1209600
LOG_LEVEL=INFO
